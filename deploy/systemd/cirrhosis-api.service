[Unit]
Description=Liver Cirrhosis ML Prediction API Service
After=network.target

[Service]
Type=simple
User=appuser
Group=appgroup
WorkingDirectory=/opt/cirrhosis-api
Environment="PATH=/opt/cirrhosis-api/.venv/bin"
EnvironmentFile=/opt/cirrhosis-api/.env
ExecStart=/opt/cirrhosis-api/.venv/bin/uvicorn api.main:app --host 0.0.0.0 --port 8000 --workers 4 --proxy-headers
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cirrhosis-api

# Security sandboxing options for systemd
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/cirrhosis-api/artifacts

[Install]
WantedBy=multi-user.target

